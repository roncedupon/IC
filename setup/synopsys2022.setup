
#-------------------------------------------------------------------------------------------------
#我自己的IC开发环境
export SOFTWARE_INSTALLED_HOME=/mnt/disk_0/softwares
export IC_HOME=/home/dy/IC
export VIP_HOME=$SOFTWARE_INSTALLED_HOME/vips/vip2018/amba_svt


#====================================================
Install_Home=$SOFTWARE_INSTALLED_HOME/synopsys2022
export DVE_HOME=$Install_Home/vcs/T-2022.06-SP2
export VCS_HOME=$Install_Home/vcs/T-2022.06-SP2
# export VCS_MX_HOME=$Install_Home/vcs-mx/O-2018.09-SP2
# export LD_LIBRARY_PATH=$Install_Home/verdi/T-2022.06/share/PLI/VCS/LINUX64

export VERDI_HOME=$Install_Home/verdi/T-2022.06
export LD_LIBRARY_PATH=$VERDI_HOME/platform/LINUXAMD64/lib:$LD_LIBRARY_PATH
export SCL_HOME=$Install_Home/scl/2022.12
#VIP的HOME路径
export DESIGNWARE_HOME=$SOFTWARE_INSTALLED_HOME/vips/designware2018
export INCLUDE_HOME=$DESIGNWARE_HOME/vip/svt/amba_svt/latest/sverilog/include
export VSCODE_SETTING=/home/dy/.vscode-server/data/Machine/settings.json
#dve
PATH=$PATH:$VCS_HOME/gui/dve/bin
alias dve="dve"

#VCS
PATH=$PATH:$VCS_HOME/bin
alias vcs="vcs"
# alias cd='function _cd(){ builtin cd "$@" && ls; }; _cd'



#VERDI
PATH=$PATH:$VERDI_HOME/bin
alias verdi="verdi"

#scl
PATH=$PATH:$SCL_HOME/linux64/bin
export VCS_ARCH_OVERRIDE=linux

#LICENCE--这@后面的是hostname，
export LM_LICENSE_FILE=27050@ubuntuserver2004
alias lmg_synopsys="lmgrd -c $SCL_HOME/admin/license/Synopsys.dat -l $SCL_HOME/admin/logs/debug.log"

#export UVM_HOME=/mnt/disk_0/softwares/uvm/uvm-1.2
export UVM_HOME=$VCS_HOME/etc/uvm-1.2


#-------------------------------------------------------------------------------------------------
