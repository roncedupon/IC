
TOOL_PATH =  /App/Andestech/AndeSight_STD_v531/toolchains/nds32le-elf-mculib-v5d/bin/
CFLAGS 	  = -c -O1 -Wall -mstrict-align -mcmodel=large  -g
LDFLAGS   = -nostartfiles -static   -L./out -ltest
ARFLAGS   = -c -r

RISCV_PREFIX ?=$(TOOL_PATH)riscv32-elf-
CC            = $(RISCV_PREFIX)gcc
AR            = $(RISCV_PREFIX)ar
OBJDUMP       = $(RISCV_PREFIX)objdump 

OBJCOPY = $(TOOL_PATH)riscv32-elf-objcopy
CUR_DIR  = $(shell pwd)


UINC_DIR  = $(shell find $(CUR_DIR)/../firmware/cores/host -type d | grep -v unused)
UINC_DIR += $(CUR_DIR)/../firmware/common/include/
UINC_DIR += $(CUR_DIR)/../firmware/addr_map/
UINC_DIR += $(CUR_DIR)/../firmware/api/irq/
UINC_DIR += $(CUR_DIR)/../firmware/addr_map/per_c_header/
UINC_DIR += $(CUR_DIR)/../firmware/api/uart0/
ifdef HAS_HS_SYS0
UINC_DIR += $(CUR_DIR)/../firmware/api/hs0/
endif
ifdef HAS_DDR_SYS
UINC_DIR += $(CUR_DIR)/../firmware/api/ddr/
endif
ifdef HAS_STACKLINK_SYS0
UINC_DIR += $(CUR_DIR)/../firmware/api/stacklink0/
endif
ifdef HAS_STACKLINK_SYS1
UINC_DIR += $(CUR_DIR)/../firmware/api/stacklink0/
endif
ifdef HAS_VLINK_SYS0
UINC_DIR += $(CUR_DIR)/../firmware/api/vlink/
endif
ifdef HAS_VLINK_SYS1
UINC_DIR += $(CUR_DIR)/../firmware/api/vlink/
endif
UINC_DIR += $(CUR_DIR)/../firmware/api/crg/
ifdef SRAM_BOOT
LINKER_SCRIPT = $(CUR_DIR)/../firmware/cores/host/script_sram.ld
CFLAGS += -D SRAM_BOOT
else ifdef HAS_DDR_SYS
LINKER_SCRIPT = $(CUR_DIR)/../firmware/cores/host/script_for_ddr.ld
else ifdef HAS_STACKLINK_SYS0
LINKER_SCRIPT = $(CUR_DIR)/../firmware/cores/host/script_for_stack.ld
else
LINKER_SCRIPT = $(CUR_DIR)/../firmware/cores/host/script_ilm.ld
endif
API_DIR  = $(shell find $(CUR_DIR)/../firmware/cores/host/src -type d | grep -v unused)

C_SRCS += $(wildcard $(CUR_DIR)/../firmware/common/src/*.c)
C_SRCS += ./main.c 
C_SRCS += $(sort $(foreach file_dir,$(API_DIR),$(wildcard $(file_dir)/*.c)))
C_SRCS += $(wildcard $(CUR_DIR)/../firmware/api/intr/*.c) 
C_SRCS += $(wildcard $(CUR_DIR)/../firmware/api/uart0/*.c) 

HEADERS+= $(sort $(foreach file_dir,$(UINC_DIR),$(wildcard $(file_dir)/*.h)))
INCLUDES +=  -I ./  
INCLUDES += $(sort $(foreach file_dir,$(UINC_DIR),$(addprefix -I,$(file_dir))))
INCLUDES +=  -I $(CUR_DIR)/../firmware/addr_map/
INCLUDES +=  -I $(CUR_DIR)/../firmware/addr_map/per_c_header
INCLUDES +=  -I $(CUR_DIR)/../firmware/api/uart0/ 

ifdef HAS_CPU_SYS0
CFLAGS += -D HAS_CPU_SYS0
endif

ifdef HAS_CPU_SYS1
CFLAGS += -D HAS_CPU_SYS1
endif

ifdef HAS_HS_SYS0
CFLAGS += -D HAS_HS_SYS0
endif

ifdef HAS_HS_SYS1
CFLAGS += -D HAS_HS_SYS1
endif

BIN2HEX  = ./bin2hex
PATTEN = @ 
ECHO = echo
OUT = ./out
SRC_FILE  = 
ASM_SRCS:= $(CUR_DIR)/../firmware/cores/host/start.S

ASM_OBJS := $(ASM_SRCS:.S=.o)
C_OBJS := $(C_SRCS:.c=.o)
LINK_OBJS +=  $(C_OBJS)
OBJS      += $(sort $(foreach o,$(foreach f,$(LINK_OBJS),$(notdir $(f))),$(addprefix $(OUT)/, $(o))))
AOBJS      += $(sort $(foreach o,$(foreach f,$(ASM_OBJS),$(notdir $(f))),$(addprefix $(OUT)/, $(o))))

export PATH := $(TOOL_PATH):$(PATH)