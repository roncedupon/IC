/*=== macro uvm_do defined in /mnt/disk_0/IC/uvm-1.2/src/macros/uvm_sequence_defines.svh(91) */ 

/*=== /mnt/disk_0/IC/uvm-1.2/src/seq/uvm_sequence_builtin.svh(280), macro uvm_do_on_pri_with(SEQ_OR_ITEM=item, SEQR=m_sequencer, PRIORITY=-1, CONSTRAINTS={}) */
begin 
  uvm_sequence_base __seq; 
  `uvm_create_on(item, m_sequencer) 
  if (!$cast(__seq,item)) start_item(item, -1);
  if ((__seq == null || !__seq.do_not_randomize) && !item.randomize() with {} ) begin 
    `uvm_warning("RNDFLD", "Randomization failed in uvm_do_with action") 
  end
  if (!$cast(__seq,item)) finish_item(item, -1); 
  else __seq.start(m_sequencer, this, -1, 0); 
  end
