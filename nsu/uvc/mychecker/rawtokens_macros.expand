begin 
        `svt_xvm_create_on(wr_seq[mstr], p_sequencer.master_sequencer[mstr]) 
        wr_seq[mstr].priority_start(this, -1); 
        if (!wr_seq[mstr].get_do_not_randomize() && !wr_seq[mstr].randomize() with {            slv_num                == slv;            num_of_wr_xact         == num_write_xacts;            address                == RANDOM_ADDR;            id                     == SET_OF_REPT_ID;            interleave             == RANDOM_INTERLEAVE;             min_id                 == local:: min_wr_id_width;             } ) 
          `svt_xvm_warning("RNDFLD", "Randomization failed in uvm_do_with action") 
        wr_seq[mstr].priority_finish(this, -1); 
      end
