`svt_xvm_do_on_pri(slv_seq[slv], p_sequencer.slave_sequencer[slv], -1)
/*=== macro svt_xvm_do_on defined in /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_uvm_util.svip(1494) */ 

