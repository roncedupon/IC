begin 
        `svt_xvm_create_on(slv_seq[slv], p_sequencer.slave_sequencer[slv]) 
        slv_seq[slv].priority_start(this, -1); 
        if (!slv_seq[slv].get_do_not_randomize() && !slv_seq[slv].randomize()) 
          `svt_xvm_warning("RNDFLD", "Randomization failed in uvm_do_on action") 
        slv_seq[slv].priority_finish(this, -1); 
      end
/*=== macro svt_xvm_do_on_pri defined in /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_uvm_util.svip(1502) */ 

