begin 
        `svt_xvm_create_on(locked_excl_seq, p_sequencer.master_sequencer[mstr]) 
        locked_excl_seq.priority_start(this, -1); 
        if (!locked_excl_seq.get_do_not_randomize() && !locked_excl_seq.randomize() with {          slv_num == slv;          } ) 
          `svt_xvm_warning("RNDFLD", "Randomization failed in uvm_do_with action") 
        locked_excl_seq.priority_finish(this, -1); 
      end
