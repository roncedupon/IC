`ifdef uvm_error_context 
     do 
     `uvm_error_context("transaction_type_check", $sformatf("If send_non_dvm_xact_from_first_port_select is set, the total number of DVM capable masters must be more than that of the masters for which dvm multi-part is being requested. num_dvm_ace_ports = 'd%0d. num_dvm_ace_lite_ports = 'd%0d. dvm_port1_multipart_select = 'b%0b.   dvm_port2_multipart_select = 'b%0b", dvm_ace_ports.size(), dvm_ace_lite_ports.size(), dvm_port1_multipart_select, dvm_port2_multipart_select), reporter) 
