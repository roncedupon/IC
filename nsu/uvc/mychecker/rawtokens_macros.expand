/*=== macro uvm_line defined in /mnt/disk_0/IC/uvm-1.2/src/macros/uvm_message_defines.svh(51) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_ordering_sequence_collection.svp(5830), macro SVT_AXI_XACT_STATUS_ENDED(this_xact=wr_seq[1].wr_xact_req[0]) */
( 
  ( 
    ( 
      (wr_seq[1].wr_xact_req[0].port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) || 
      (wr_seq[1].wr_xact_req[0].port_cfg.axi_interface_type == svt_axi_port_configuration::ACE_LITE) 
    ) && 
    (wr_seq[1].wr_xact_req[0].is_coherent_xact_dropped == 1) 
  ) || 
  ( 
    (wr_seq[1].wr_xact_req[0].port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) && 
    ( 
      (wr_seq[1].wr_xact_req[0].ack_status == svt_axi_transaction::ACCEPT) || 
      (wr_seq[1].wr_xact_req[0].ack_status == svt_axi_transaction::ABORTED) 
    ) 
  ) || 
  ( 
    (wr_seq[1].wr_xact_req[0].port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_WRITE(wr_seq[1].wr_xact_req[0])) && 
    ( 
      ( 
        (wr_seq[1].wr_xact_req[0].write_resp_status == svt_axi_transaction::ACCEPT) || 
        (wr_seq[1].wr_xact_req[0].write_resp_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) || 
  ( 
    (wr_seq[1].wr_xact_req[0].port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_READ(wr_seq[1].wr_xact_req[0])) &&  
    ( 
      ( 
        (wr_seq[1].wr_xact_req[0].data_status == svt_axi_transaction::ACCEPT) || 
        (wr_seq[1].wr_xact_req[0].data_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
