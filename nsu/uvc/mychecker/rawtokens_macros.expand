$sformatf("{OBJECT_NUM('d%0d) PORT_ID('d%0d) PORT_NAME(%0s) TYPE(%0s) COHERENT_XACT_TYPE(%0s) ID('h%0x) SECURE('d%0d) ADDR('h%0x) CACHE_TYPE('d%0d) %0s%0s%0s} ",
          ((wr_seq[1].wr_xact_req[0] != null)?wr_seq[1].wr_xact_req[0].object_id:-1),
          ((wr_seq[1].wr_xact_req[0] != null)?wr_seq[1].wr_xact_req[0].port_id:-1),
          (((wr_seq[1].wr_xact_req[0] != null)&&(wr_seq[1].wr_xact_req[0].port_cfg!=null))?wr_seq[1].wr_xact_req[0].port_cfg.get_port_name():""),
          ((wr_seq[1].wr_xact_req[0] != null)?wr_seq[1].wr_xact_req[0].xact_type.name:"null"),
          ((wr_seq[1].wr_xact_req[0] != null)?wr_seq[1].wr_xact_req[0].coherent_xact_type.name:"null"),
          ((wr_seq[1].wr_xact_req[0] != null)?wr_seq[1].wr_xact_req[0].id:0),
          ((wr_seq[1].wr_xact_req[0] != null)?!wr_seq[1].wr_xact_req[0].prot_type[1]:0),
          ((wr_seq[1].wr_xact_req[0] != null)?wr_seq[1].wr_xact_req[0].addr:0),
          ((wr_seq[1].wr_xact_req[0] != null)?wr_seq[1].wr_xact_req[0].cache_type:0),
          ((wr_seq[1].wr_xact_req[0] != null)?(wr_seq[1].wr_xact_req[0].atomic_type==svt_axi_transaction::EXCLUSIVE)?"EXCL":"":""),
          ((wr_seq[1].wr_xact_req[0] != null)?((wr_seq[1].wr_xact_req[0].get_begin_time()==-1)?"":($sformatf(" START_TIME(%0t)",wr_seq[1].wr_xact_req[0].get_begin_realtime()))):""),
          ((wr_seq[1].wr_xact_req[0] != null)?((wr_seq[1].wr_xact_req[0].get_end_time()==-1)?"":($sformatf(" END_TIME(%0t)",wr_seq[1].wr_xact_req[0].get_end_realtime()))):""))
