((req[0].xact_type == svt_axi_transaction::WRITE) || 
   ((req[0].xact_type == svt_axi_transaction::COHERENT) && 
    ((req[0].coherent_xact_type == svt_axi_transaction::WRITENOSNOOP) || 
     (req[0].coherent_xact_type == svt_axi_transaction::WRITEUNIQUE) || 
