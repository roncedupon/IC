begin 
     if (uvm_report_enabled(UVM_NONE,UVM_WARNING,"RNDFLD")) 
       uvm_report_warning ("RNDFLD", "Randomization failed in uvm_do_with action", UVM_NONE, `uvm_file, `uvm_line, "", 1); 
