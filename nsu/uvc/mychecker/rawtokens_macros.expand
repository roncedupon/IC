begin 
        `svt_xvm_create_on(wr_xact_req[wr], p_sequencer.master_sequencer[mstr]) 
        wr_xact_req[wr].priority_start(this, -1); 
        if (!wr_xact_req[wr].get_do_not_randomize() && !wr_xact_req[wr].randomize() with {                            addr               >= lo_addr;              addr               <= hi_addr-(burst_length*(1<<burst_size));              if (wr==1) {                id               == wr_id;              }                xact_type          == _write_xact_type[mstr];              coherent_xact_type == svt_axi_transaction::WRITENOSNOOP;              atomic_type        == svt_axi_transaction::NORMAL;                             cache_type[1:0]    == 2'b00;              burst_type         inside {svt_axi_transaction::INCR, svt_axi_transaction::WRAP};            } ) 
          `svt_xvm_warning("RNDFLD", "Randomization failed in uvm_do_with action") 
        wr_xact_req[wr].priority_finish(this, -1); 
      end
