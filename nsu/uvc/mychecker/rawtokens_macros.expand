/*=== macro SVT_IF_UTIL_SUPPORT_SIGNAL_LOGGING_IMPL defined in /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_if_util.svip(93) */ 

