/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_exception_list.svp(233), macro uvm_print_array_object3(F=exceptions, P=__m_uvm_status_container.printer, FLAG=`SVT_ALL_ON|`SVT_NOCOMPARE|`SVT_NOPACK|`SVT_DEEP) */
`uvm_print_object_qda4(exceptions, __m_uvm_status_container.printer, da,`SVT_ALL_ON|`SVT_NOCOMPARE|`SVT_NOPACK|`SVT_DEEP)
/*=== macro uvm_print_array_object3 defined in /mnt/disk_0/IC/uvm-1.2/src/macros/uvm_printer_defines.svh(193) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_exception_list.svp(233), macro uvm_print_object_qda4(F=exceptions, P=__m_uvm_status_container.printer, T=da, FLAG=`SVT_ALL_ON|`SVT_NOCOMPARE|`SVT_NOPACK|`SVT_DEEP) */
do begin 
    int curr, max__; 
    uvm_printer p__; 
    max__=0; curr=0; 
    if(__m_uvm_status_container.printer!=null) p__ = __m_uvm_status_container.printer; 
    else p__ = uvm_default_printer; 
    
    foreach(exceptions[i]) max__ = i+1; 

    

    p__.m_scope.set_arg("exceptions");
    p__.print_array_header("exceptions", max__, "da(object)");
    if((p__.knobs.depth == -1) || (p__.knobs.depth+1 > p__.m_scope.depth())) 
    begin
      for(curr=0; curr<max__ && (p__.knobs.begin_elements == -1 || 
         p__.knobs.end_elements == -1 || curr<p__.knobs.begin_elements); ++curr) begin 
        if(((`SVT_ALL_ON|`SVT_NOCOMPARE|`SVT_NOPACK|`SVT_DEEP)&UVM_REFERENCE) == 0) 
          p__.print_object(p__.index_string(curr), exceptions[curr], "[");
        else 
          p__.print_object_header(p__.index_string(curr), exceptions[curr], "[");
      end 
      if(curr<max__) begin
        curr = max__-p__.knobs.end_elements;
        if(curr<p__.knobs.begin_elements) curr = p__.knobs.begin_elements;
        else begin
          p__.print_array_range(p__.knobs.begin_elements, curr-1);
        end
        for(curr=curr; curr<max__; ++curr) begin
          if(((`SVT_ALL_ON|`SVT_NOCOMPARE|`SVT_NOPACK|`SVT_DEEP)&UVM_REFERENCE) == 0) 
            p__.print_object(p__.index_string(curr), exceptions[curr], "[");
          else 
            p__.print_object_header(p__.index_string(curr), exceptions[curr], "[");
        end 
      end
    end 

    p__.print_array_footer(max__); 
    
  end while(0);
