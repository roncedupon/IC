begin 
        `svt_xvm_create_on(locked_seq, p_sequencer.master_sequencer[mstr]) 
        locked_seq.priority_start(this, -1); 
        if (!locked_seq.get_do_not_randomize() && !locked_seq.randomize() with {          slv_num == slv;          } ) 
          `svt_xvm_warning("RNDFLD", "Randomization failed in uvm_do_with action") 
        locked_seq.priority_finish(this, -1); 
      end
