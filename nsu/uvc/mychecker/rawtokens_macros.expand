  ignore_bins ignore_aligned_addr_offset_0  = binsof(addr_offset) intersect {0}; 
 
  ignore_bins ignore_addr_offset_2_3     = binsof(addr_offset) intersect {2,3} iff(cfg.data_width < 32); 
