    ( 
      (wr_seq.wr_xact_req[0].ack_status == svt_axi_transaction::ACCEPT) || 
      (wr_seq.wr_xact_req[0].ack_status == svt_axi_transaction::ABORTED) 
    ) 
  ) || 
  ( 
    (wr_seq.wr_xact_req[0].port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_WRITE(wr_seq.wr_xact_req[0])) && 
