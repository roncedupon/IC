( 
  ( 
    ( 
      (wr_xact_req[0].port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) || 
      (wr_xact_req[0].port_cfg.axi_interface_type == svt_axi_port_configuration::ACE_LITE) 
    ) && 
    (wr_xact_req[0].is_coherent_xact_dropped == 1) 
  ) || 
  ( 
    (wr_xact_req[0].port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) && 
    ( 
      (wr_xact_req[0].ack_status == svt_axi_transaction::ACCEPT) || 
      (wr_xact_req[0].ack_status == svt_axi_transaction::ABORTED) 
    ) 
  ) || 
  ( 
    (wr_xact_req[0].port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_WRITE(wr_xact_req[0])) && 
    ( 
      ( 
        (wr_xact_req[0].write_resp_status == svt_axi_transaction::ACCEPT) || 
        (wr_xact_req[0].write_resp_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) || 
  ( 
    (wr_xact_req[0].port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_READ(wr_xact_req[0])) &&  
    ( 
      ( 
        (wr_xact_req[0].data_status == svt_axi_transaction::ACCEPT) || 
        (wr_xact_req[0].data_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) 
)
/*=== macro SVT_AXI_XACT_STATUS_ENDED defined in /mnt/disk_0/softwares/vips/vip2020/include/sverilog/svt_axi_common_defines.svi(3436) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_burst_sequence_collection.svp(532), macro SVT_AXI_IS_TRANSMITTED_CHANNEL_WRITE(obj=wr_xact_req[0]) */
((wr_xact_req[0].xact_type == svt_axi_transaction::WRITE) || 
   ((wr_xact_req[0].xact_type == svt_axi_transaction::COHERENT) && 
    ((wr_xact_req[0].coherent_xact_type == svt_axi_transaction::WRITENOSNOOP) || 
     (wr_xact_req[0].coherent_xact_type == svt_axi_transaction::WRITEUNIQUE) || 
`ifdef SVT_ACE5_ENABLE 
     (wr_xact_req[0].coherent_xact_type == svt_axi_transaction::WRITEUNIQUEPTLSTASH) || 
     (wr_xact_req[0].coherent_xact_type == svt_axi_transaction::WRITEUNIQUEFULLSTASH) || 
     (wr_xact_req[0].coherent_xact_type == svt_axi_transaction::STASHONCESHARED) || 
     (wr_xact_req[0].coherent_xact_type == svt_axi_transaction::STASHONCEUNIQUE) || 
     (wr_xact_req[0].coherent_xact_type == svt_axi_transaction::STASHTRANSLATION) || 
