( 
  ( 
    ( 
      (req[0].port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) || 
      (req[0].port_cfg.axi_interface_type == svt_axi_port_configuration::ACE_LITE) 
    ) && 
    (req[0].is_coherent_xact_dropped == 1) 
  ) || 
  ( 
    (req[0].port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) && 
    ( 
      (req[0].ack_status == svt_axi_transaction::ACCEPT) || 
      (req[0].ack_status == svt_axi_transaction::ABORTED) 
    ) 
  ) || 
  ( 
    (req[0].port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_WRITE(req[0])) && 
    ( 
      ( 
        (req[0].write_resp_status == svt_axi_transaction::ACCEPT) || 
        (req[0].write_resp_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) || 
  ( 
    (req[0].port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_READ(req[0])) &&  
    ( 
      ( 
        (req[0].data_status == svt_axi_transaction::ACCEPT) || 
        (req[0].data_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) 
)
/*=== macro SVT_AXI_XACT_STATUS_ENDED defined in /mnt/disk_0/softwares/vips/vip2020/include/sverilog/svt_axi_common_defines.svi(3436) */ 

