   end
/*=== macro uvm_info defined in /mnt/disk_0/IC/uvm-1.2/src/macros/uvm_message_defines.svh(116) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_ordering_sequence_collection.svp(2528), macro SVT_AXI_PRINT_PREFIX1(xact=wr_seq.wr_xact_req[wr]) */
$sformatf("{OBJECT_NUM('d%0d) PORT_ID('d%0d) PORT_NAME(%0s) TYPE(%0s) COHERENT_XACT_TYPE(%0s) ID('h%0x) SECURE('d%0d) ADDR('h%0x) CACHE_TYPE('d%0d) %0s%0s%0s} ",
          ((wr_seq.wr_xact_req[wr] != null)?wr_seq.wr_xact_req[wr].object_id:-1),
          ((wr_seq.wr_xact_req[wr] != null)?wr_seq.wr_xact_req[wr].port_id:-1),
          (((wr_seq.wr_xact_req[wr] != null)&&(wr_seq.wr_xact_req[wr].port_cfg!=null))?wr_seq.wr_xact_req[wr].port_cfg.get_port_name():""),
          ((wr_seq.wr_xact_req[wr] != null)?wr_seq.wr_xact_req[wr].xact_type.name:"null"),
          ((wr_seq.wr_xact_req[wr] != null)?wr_seq.wr_xact_req[wr].coherent_xact_type.name:"null"),
          ((wr_seq.wr_xact_req[wr] != null)?wr_seq.wr_xact_req[wr].id:0),
          ((wr_seq.wr_xact_req[wr] != null)?!wr_seq.wr_xact_req[wr].prot_type[1]:0),
          ((wr_seq.wr_xact_req[wr] != null)?wr_seq.wr_xact_req[wr].addr:0),
          ((wr_seq.wr_xact_req[wr] != null)?wr_seq.wr_xact_req[wr].cache_type:0),
          ((wr_seq.wr_xact_req[wr] != null)?(wr_seq.wr_xact_req[wr].atomic_type==svt_axi_transaction::EXCLUSIVE)?"EXCL":"":""),
          ((wr_seq.wr_xact_req[wr] != null)?((wr_seq.wr_xact_req[wr].get_begin_time()==-1)?"":($sformatf(" START_TIME(%0t)",wr_seq.wr_xact_req[wr].get_begin_realtime()))):""),
          ((wr_seq.wr_xact_req[wr] != null)?((wr_seq.wr_xact_req[wr].get_end_time()==-1)?"":($sformatf(" END_TIME(%0t)",wr_seq.wr_xact_req[wr].get_end_realtime()))):""))
/*=== macro SVT_AXI_PRINT_PREFIX1 defined in /mnt/disk_0/softwares/vips/vip2020/include/sverilog/svt_axi_common_defines.svi(3118) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_ordering_sequence_collection.svp(2528), macro uvm_file */
`__FILE__
/*=== macro uvm_file defined in /mnt/disk_0/IC/uvm-1.2/src/macros/uvm_message_defines.svh(45) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_ordering_sequence_collection.svp(2528), macro uvm_line */
`__LINE__
/*=== macro uvm_line defined in /mnt/disk_0/IC/uvm-1.2/src/macros/uvm_message_defines.svh(51) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_ordering_sequence_collection.svp(2530), macro SVT_AXI_XACT_STATUS_ENDED(this_xact=wr_seq.wr_xact_req[wr]) */
( 
  ( 
    ( 
      (wr_seq.wr_xact_req[wr].port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) || 
      (wr_seq.wr_xact_req[wr].port_cfg.axi_interface_type == svt_axi_port_configuration::ACE_LITE) 
    ) && 
    (wr_seq.wr_xact_req[wr].is_coherent_xact_dropped == 1) 
  ) || 
  ( 
    (wr_seq.wr_xact_req[wr].port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) && 
    ( 
      (wr_seq.wr_xact_req[wr].ack_status == svt_axi_transaction::ACCEPT) || 
      (wr_seq.wr_xact_req[wr].ack_status == svt_axi_transaction::ABORTED) 
    ) 
  ) || 
  ( 
    (wr_seq.wr_xact_req[wr].port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_WRITE(wr_seq.wr_xact_req[wr])) && 
    ( 
      ( 
        (wr_seq.wr_xact_req[wr].write_resp_status == svt_axi_transaction::ACCEPT) || 
        (wr_seq.wr_xact_req[wr].write_resp_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) || 
  ( 
    (wr_seq.wr_xact_req[wr].port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_READ(wr_seq.wr_xact_req[wr])) &&  
    ( 
      ( 
        (wr_seq.wr_xact_req[wr].data_status == svt_axi_transaction::ACCEPT) || 
        (wr_seq.wr_xact_req[wr].data_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) 
)
/*=== macro SVT_AXI_XACT_STATUS_ENDED defined in /mnt/disk_0/softwares/vips/vip2020/include/sverilog/svt_axi_common_defines.svi(3436) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_ordering_sequence_collection.svp(2530), macro SVT_AXI_IS_TRANSMITTED_CHANNEL_WRITE(obj=wr_seq.wr_xact_req[wr]) */
((wr_seq.wr_xact_req[wr].xact_type == svt_axi_transaction::WRITE) || 
   ((wr_seq.wr_xact_req[wr].xact_type == svt_axi_transaction::COHERENT) && 
    ((wr_seq.wr_xact_req[wr].coherent_xact_type == svt_axi_transaction::WRITENOSNOOP) || 
