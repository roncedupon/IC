( 
  ( 
    ( 
      (xact.port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) || 
      (xact.port_cfg.axi_interface_type == svt_axi_port_configuration::ACE_LITE) 
    ) && 
    (xact.is_coherent_xact_dropped == 1) 
  ) || 
  ( 
    (xact.port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) && 
    ( 
      (xact.ack_status == svt_axi_transaction::ACCEPT) || 
      (xact.ack_status == svt_axi_transaction::ABORTED) 
    ) 
  ) || 
  ( 
    (xact.port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_WRITE(xact)) && 
    ( 
      ( 
        (xact.write_resp_status == svt_axi_transaction::ACCEPT) || 
        (xact.write_resp_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) || 
  ( 
    (xact.port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_READ(xact)) &&  
    ( 
      ( 
        (xact.data_status == svt_axi_transaction::ACCEPT) || 
        (xact.data_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) 
)
