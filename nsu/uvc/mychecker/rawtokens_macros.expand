`ifdef SVT_FSDB_ENABLE 
  initial begin 
`ifdef QUESTA 
     
     
    static reg [80*8:1] fsdbfile_plus_filename = {"+fsdbfile+",`SVT_DEBUG_OPTS_FSDB_FILE_NAME}; 
`endif 
    wait(enable_signal_log == 1); 
`ifdef SVT_IF_UTIL_DISABLE_DEFAULT_FSDB 
     
     
     
     
     
    $fsdbDumpfile(`SVT_DEBUG_OPTS_FSDB_FILE_NAME, "+no_default"); 
`endif 
`ifdef QUESTA 
    $fsdbDumpvars(1,$sformatf("%m"),"+all",fsdbfile_plus_filename); 
`else 
    $fsdbDumpvars(1,$sformatf("%m"),"+all",{"+fsdbfile+",`SVT_DEBUG_OPTS_FSDB_FILE_NAME}); 
`endif 
  end 
`endif
