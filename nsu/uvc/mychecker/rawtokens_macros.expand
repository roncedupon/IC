  ignore_bins Ig_algn_2_4_Bxfer_256dw = ((binsof(addr_offset)intersect {['h19:'h1c]}) && (binsof(transfer_size.xfer_size_2byte) || binsof(transfer_size.xfer_size_4byte))) iff(cfg.data_width == 256); 
