    bins cresp_0000 = {4'b0000}; 
    bins cresp_1000 = {4'b1000}; 
    bins cresp_0001 = {4'b0001}; 
    bins cresp_1001 = {4'b1001}; 
    bins cresp_0101 = {4'b0101}; 
    bins cresp_1101 = {4'b1101}; 
    option.weight = 1; 
