( 
  ( 
    ( 
      (wr_seq_q[m].wr_xact_req[wr_l].port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) || 
      (wr_seq_q[m].wr_xact_req[wr_l].port_cfg.axi_interface_type == svt_axi_port_configuration::ACE_LITE) 
    ) && 
    (wr_seq_q[m].wr_xact_req[wr_l].is_coherent_xact_dropped == 1) 
  ) || 
  ( 
    (wr_seq_q[m].wr_xact_req[wr_l].port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) && 
    ( 
      (wr_seq_q[m].wr_xact_req[wr_l].ack_status == svt_axi_transaction::ACCEPT) || 
      (wr_seq_q[m].wr_xact_req[wr_l].ack_status == svt_axi_transaction::ABORTED) 
    ) 
