    ( 
      (_master_xact.ack_status == svt_axi_transaction::ACCEPT) || 
      (_master_xact.ack_status == svt_axi_transaction::ABORTED) 
    ) 
  ) || 
  ( 
    (_master_xact.port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
