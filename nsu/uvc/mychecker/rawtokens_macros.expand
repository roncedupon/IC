( 
  ( 
    ( 
      (barrier_flag_read_seq.output_read_xact.port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) || 
      (barrier_flag_read_seq.output_read_xact.port_cfg.axi_interface_type == svt_axi_port_configuration::ACE_LITE) 
    ) && 
    (barrier_flag_read_seq.output_read_xact.is_coherent_xact_dropped == 1) 
  ) || 
  ( 
    (barrier_flag_read_seq.output_read_xact.port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) && 
    ( 
      (barrier_flag_read_seq.output_read_xact.ack_status == svt_axi_transaction::ACCEPT) || 
      (barrier_flag_read_seq.output_read_xact.ack_status == svt_axi_transaction::ABORTED) 
    ) 
  ) || 
  ( 
    (barrier_flag_read_seq.output_read_xact.port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_WRITE(barrier_flag_read_seq.output_read_xact)) && 
    ( 
      ( 
        (barrier_flag_read_seq.output_read_xact.write_resp_status == svt_axi_transaction::ACCEPT) || 
        (barrier_flag_read_seq.output_read_xact.write_resp_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) || 
  ( 
    (barrier_flag_read_seq.output_read_xact.port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_READ(barrier_flag_read_seq.output_read_xact)) &&  
    ( 
      ( 
        (barrier_flag_read_seq.output_read_xact.data_status == svt_axi_transaction::ACCEPT) || 
        (barrier_flag_read_seq.output_read_xact.data_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) 
)
