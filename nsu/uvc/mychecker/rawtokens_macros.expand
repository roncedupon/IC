      (wr_seq.wr_xact_req[0].port_cfg.axi_interface_type == svt_axi_port_configuration::ACE_LITE) 
    ) && 
    (wr_seq.wr_xact_req[0].is_coherent_xact_dropped == 1) 
  ) || 
  ( 
