begin 
        `svt_xvm_create_on(wr_xact_req[0], p_sequencer.master_sequencer[mstr]) 
        wr_xact_req[0].priority_start(this, -1); 
        if (!wr_xact_req[0].get_do_not_randomize() && !wr_xact_req[0].randomize() with {            addr                    == 0;            xact_type               == svt_axi_transaction::WRITE;            atomic_type             == svt_axi_transaction::NORMAL;            burst_type              dist {svt_axi_transaction::INCR:/5 , svt_axi_transaction::WRAP:/1, svt_axi_transaction::FIXED:/15 };               } ) 
          `svt_xvm_warning("RNDFLD", "Randomization failed in uvm_do_with action") 
        wr_xact_req[0].priority_finish(this, -1); 
      end
