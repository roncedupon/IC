`svt_xvm_do_on_pri_with(req, m_sequencer, -1, {              xact_type == xact_type_int;              atomic_type == svt_axi_transaction::EXCLUSIVE;              cache_type == 0;              if(i < 4)                burst_length == 2**i;              else                burst_length == 8;              if(!j && use_slv_num) {                addr >= lo_addr;                addr <= hi_addr-(burst_length*(1<<burst_size));                coherent_xact_type == svt_axi_transaction::READNOSNOOP;                if (port_cfg.use_separate_rd_wr_chan_id_width == 1)                 id == id_val;               }              else if(j == 1 && use_slv_num)                coherent_xact_type == svt_axi_transaction::WRITENOSNOOP;              if (j == 1) {                addr == ex_wr_addr;                burst_size == burst_size_int;                burst_type == burst_type_int;                prot_type == prot_type_int;                id == ex_wr_id;              }            })
