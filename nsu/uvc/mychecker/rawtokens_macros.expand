begin 
     if (uvm_report_enabled(UVM_LOW,UVM_INFO,"report")) 
       uvm_report_info ("report", $sformatf("Message ID `%s` was removed, and was detected %0d times", ids_to_demote_removed[id], demoted_id_count[ids_to_demote_removed[id]]), UVM_LOW, `uvm_file, `uvm_line, "", 1); 
   end
