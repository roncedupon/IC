     (xact.coherent_xact_type == svt_axi_transaction::WRITEEVICT) || 
     (xact.coherent_xact_type == svt_axi_transaction::EVICT) || 
     (xact.coherent_xact_type == svt_axi_transaction::WRITEBARRIER) 
    ) 
   ) 
  ) 
