`svt_xvm_do_on_pri_with(wr_seq, p_sequencer.master_sequencer[mstr], -1, {            slv_num             == slv;            num_of_wr_xact      == num_write_xacts;            address             == RANDOM_ADDR;            id                  == DIFF;             interleave          == RANDOM_INTERLEAVE;          })
/*=== macro svt_xvm_do_on_with defined in /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_uvm_util.svip(1504) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_ordering_sequence_collection.svp(6465), macro svt_xvm_do_on_pri_with(SEQ_OR_ITEM=wr_seq, SEQR=p_sequencer.master_sequencer[mstr], PRIORITY=-1, CONSTRAINTS={            slv_num             == slv;            num_of_wr_xact      == num_write_xacts;            address             == RANDOM_ADDR;            id                  == DIFF;             interleave          == RANDOM_INTERLEAVE;          }) */
begin 
        `svt_xvm_create_on(wr_seq, p_sequencer.master_sequencer[mstr]) 
        wr_seq.priority_start(this, -1); 
        if (!wr_seq.get_do_not_randomize() && !wr_seq.randomize() with {            slv_num             == slv;            num_of_wr_xact      == num_write_xacts;            address             == RANDOM_ADDR;            id                  == DIFF;             interleave          == RANDOM_INTERLEAVE;          } ) 
          `svt_xvm_warning("RNDFLD", "Randomization failed in uvm_do_with action") 
        wr_seq.priority_finish(this, -1); 
      end
/*=== macro svt_xvm_do_on_pri_with defined in /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_uvm_util.svip(1512) */ 

