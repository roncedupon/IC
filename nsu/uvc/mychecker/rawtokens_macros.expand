$sformatf("{OBJECT_NUM('d%0d) PORT_ID('d%0d) PORT_NAME(%0s) TYPE(%0s) COHERENT_XACT_TYPE(%0s) ID('h%0x) SECURE('d%0d) ADDR('h%0x) CACHE_TYPE('d%0d) %0s%0s%0s} ",
          ((wr_seq_q[m].wr_xact_req[wr_l] != null)?wr_seq_q[m].wr_xact_req[wr_l].object_id:-1),
          ((wr_seq_q[m].wr_xact_req[wr_l] != null)?wr_seq_q[m].wr_xact_req[wr_l].port_id:-1),
          (((wr_seq_q[m].wr_xact_req[wr_l] != null)&&(wr_seq_q[m].wr_xact_req[wr_l].port_cfg!=null))?wr_seq_q[m].wr_xact_req[wr_l].port_cfg.get_port_name():""),
          ((wr_seq_q[m].wr_xact_req[wr_l] != null)?wr_seq_q[m].wr_xact_req[wr_l].xact_type.name:"null"),
          ((wr_seq_q[m].wr_xact_req[wr_l] != null)?wr_seq_q[m].wr_xact_req[wr_l].coherent_xact_type.name:"null"),
          ((wr_seq_q[m].wr_xact_req[wr_l] != null)?wr_seq_q[m].wr_xact_req[wr_l].id:0),
          ((wr_seq_q[m].wr_xact_req[wr_l] != null)?!wr_seq_q[m].wr_xact_req[wr_l].prot_type[1]:0),
          ((wr_seq_q[m].wr_xact_req[wr_l] != null)?wr_seq_q[m].wr_xact_req[wr_l].addr:0),
