        `svt_xvm_create_on(req, m_sequencer) 
        req.priority_start(this, -1); 
        if (!req.get_do_not_randomize() && !req.randomize() with {            xact_type ==   svt_axi_transaction::READ;            atomic_type == svt_axi_transaction::LOCKED;            data_before_addr == 0;            id == 0;            cache_type == 0;            addr >= lo_addr;            addr <= hi_addr-((1<<burst_size)*burst_length);          } ) 
