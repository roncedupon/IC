/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_sequence_item.svp(762), macro uvm_print_array_object3(F=trace, P=__m_uvm_status_container.printer, FLAG=`SVT_ALL_ON|`SVT_NOPACK|`SVT_NOCOMPARE|`SVT_NOCOPY|`SVT_NORECORD|UVM_REFERENCE) */
`uvm_print_object_qda4(trace, __m_uvm_status_container.printer, da,`SVT_ALL_ON|`SVT_NOPACK|`SVT_NOCOMPARE|`SVT_NOCOPY|`SVT_NORECORD|UVM_REFERENCE)
/*=== macro uvm_print_array_object3 defined in /mnt/disk_0/IC/uvm-1.2/src/macros/uvm_printer_defines.svh(193) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_sequence_item.svp(762), macro uvm_print_object_qda4(F=trace, P=__m_uvm_status_container.printer, T=da, FLAG=`SVT_ALL_ON|`SVT_NOPACK|`SVT_NOCOMPARE|`SVT_NOCOPY|`SVT_NORECORD|UVM_REFERENCE) */
do begin 
    int curr, max__; 
    uvm_printer p__; 
    max__=0; curr=0; 
    if(__m_uvm_status_container.printer!=null) p__ = __m_uvm_status_container.printer; 
    else p__ = uvm_default_printer; 
    
    foreach(trace[i]) max__ = i+1; 

    

    p__.m_scope.set_arg("trace");
    p__.print_array_header("trace", max__, "da(object)");
    if((p__.knobs.depth == -1) || (p__.knobs.depth+1 > p__.m_scope.depth())) 
    begin
      for(curr=0; curr<max__ && (p__.knobs.begin_elements == -1 || 
         p__.knobs.end_elements == -1 || curr<p__.knobs.begin_elements); ++curr) begin 
        if(((`SVT_ALL_ON|`SVT_NOPACK|`SVT_NOCOMPARE|`SVT_NOCOPY|`SVT_NORECORD|UVM_REFERENCE)&UVM_REFERENCE) == 0) 
          p__.print_object(p__.index_string(curr), trace[curr], "[");
        else 
          p__.print_object_header(p__.index_string(curr), trace[curr], "[");
      end 
      if(curr<max__) begin
        curr = max__-p__.knobs.end_elements;
        if(curr<p__.knobs.begin_elements) curr = p__.knobs.begin_elements;
        else begin
          p__.print_array_range(p__.knobs.begin_elements, curr-1);
        end
        for(curr=curr; curr<max__; ++curr) begin
          if(((`SVT_ALL_ON|`SVT_NOPACK|`SVT_NOCOMPARE|`SVT_NOCOPY|`SVT_NORECORD|UVM_REFERENCE)&UVM_REFERENCE) == 0) 
            p__.print_object(p__.index_string(curr), trace[curr], "[");
          else 
            p__.print_object_header(p__.index_string(curr), trace[curr], "[");
        end 
      end
    end 

    p__.print_array_footer(max__); 
    
  end while(0);
