begin 
    if(!((`SVT_ALL_ON|`SVT_NOCOMPARE|`SVT_NOPACK|`SVT_DEEP)&UVM_NORECORD)) begin 
      int sz__ = exceptions.size(); 
      string s; 
      if(sz__ == 0 ) begin 
        __m_uvm_status_container.recorder.record_field_int("exceptions.size", 0, 32, UVM_DEC); 
      end 
      if(sz__ < 10) begin 
        foreach(exceptions[i]) begin 
           $swrite(s,"exceptions[%0d]", i); 
           __m_uvm_status_container.recorder.record_object(s, exceptions[i]); 
        end 
      end 
      else begin 
        for(int i=0; i<5; ++i) begin 
           $swrite(s,"exceptions[%0d]", i); 
           __m_uvm_status_container.recorder.record_object(s, exceptions[i]); 
        end 
        for(int i=sz__-5; i<sz__; ++i) begin 
           $swrite(s,"exceptions[%0d]", i); 
           __m_uvm_status_container.recorder.record_object(s, exceptions[i]); 
        end 
      end 
    end 
  end
