`svt_xvm_do_on_pri_with(wr_seq[mstr], p_sequencer.master_sequencer[mstr], -1, {            slv_num                == slv;            num_of_wr_xact         == num_write_xacts;            address                == RANDOM_ADDR;            id                     == SET_OF_REPT_ID;            interleave             == RANDOM_INTERLEAVE;             min_id                 == local:: min_wr_id_width;             })
/*=== macro svt_xvm_do_on_with defined in /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_uvm_util.svip(1504) */ 

