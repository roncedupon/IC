`svt_xvm_do_on_pri_with(rand_seq, p_sequencer.master_sequencer[mstr], -1, {        slv_num inside {participating_slaves_arr};         if (sys_cfg.master_cfg[mstr].axi_interface_category == svt_axi_port_configuration::AXI_WRITE_ONLY){          xact_type  ==  WRITE;        }        else if (sys_cfg.master_cfg[mstr].axi_interface_category == svt_axi_port_configuration::AXI_READ_ONLY){          xact_type  ==  READ;        }        else {          xact_type  ==  RANDOM;        }        })
/*=== macro svt_xvm_do_on_with defined in /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_uvm_util.svip(1504) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_burst_sequence_collection.svp(1110), macro svt_xvm_do_on_pri_with(SEQ_OR_ITEM=rand_seq, SEQR=p_sequencer.master_sequencer[mstr], PRIORITY=-1, CONSTRAINTS={        slv_num inside {participating_slaves_arr};         if (sys_cfg.master_cfg[mstr].axi_interface_category == svt_axi_port_configuration::AXI_WRITE_ONLY){          xact_type  ==  WRITE;        }        else if (sys_cfg.master_cfg[mstr].axi_interface_category == svt_axi_port_configuration::AXI_READ_ONLY){          xact_type  ==  READ;        }        else {          xact_type  ==  RANDOM;        }        }) */
begin 
        `svt_xvm_create_on(rand_seq, p_sequencer.master_sequencer[mstr]) 
        rand_seq.priority_start(this, -1); 
        if (!rand_seq.get_do_not_randomize() && !rand_seq.randomize() with {        slv_num inside {participating_slaves_arr};         if (sys_cfg.master_cfg[mstr].axi_interface_category == svt_axi_port_configuration::AXI_WRITE_ONLY){          xact_type  ==  WRITE;        }        else if (sys_cfg.master_cfg[mstr].axi_interface_category == svt_axi_port_configuration::AXI_READ_ONLY){          xact_type  ==  READ;        }        else {          xact_type  ==  RANDOM;        }        } ) 
          `svt_xvm_warning("RNDFLD", "Randomization failed in uvm_do_with action") 
        rand_seq.priority_finish(this, -1); 
      end
/*=== macro svt_xvm_do_on_pri_with defined in /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_uvm_util.svip(1512) */ 

