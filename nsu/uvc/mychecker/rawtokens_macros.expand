`svt_xvm_do_on_pri_with(wr_seq[wr], p_sequencer.master_sequencer[mstr], -1, {             slv_num             == selected_slv[wr];             num_of_wr_xact      == 1;             address             == NON_OVERLAP_ADDR;               memory_type         == DEVICE;             id                  == RD_WR_CHAN_MIN_ID;          })
/*=== macro svt_xvm_do_on_with defined in /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_uvm_util.svip(1504) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_ordering_sequence_collection.svp(2085), macro svt_xvm_do_on_pri_with(SEQ_OR_ITEM=wr_seq[wr], SEQR=p_sequencer.master_sequencer[mstr], PRIORITY=-1, CONSTRAINTS={             slv_num             == selected_slv[wr];             num_of_wr_xact      == 1;             address             == NON_OVERLAP_ADDR;               memory_type         == DEVICE;             id                  == RD_WR_CHAN_MIN_ID;          }) */
begin 
        `svt_xvm_create_on(wr_seq[wr], p_sequencer.master_sequencer[mstr]) 
        wr_seq[wr].priority_start(this, -1); 
        if (!wr_seq[wr].get_do_not_randomize() && !wr_seq[wr].randomize() with {             slv_num             == selected_slv[wr];             num_of_wr_xact      == 1;             address             == NON_OVERLAP_ADDR;               memory_type         == DEVICE;             id                  == RD_WR_CHAN_MIN_ID;          } ) 
          `svt_xvm_warning("RNDFLD", "Randomization failed in uvm_do_with action") 
        wr_seq[wr].priority_finish(this, -1); 
      end
/*=== macro svt_xvm_do_on_pri_with defined in /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_uvm_util.svip(1512) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_ordering_sequence_collection.svp(2085), macro svt_xvm_create_on(SEQ_OR_ITEM=wr_seq[wr], SEQR=p_sequencer.master_sequencer[mstr]) */
$cast(wr_seq[wr], create_item(wr_seq[wr].get_type(), p_sequencer.master_sequencer[mstr], "wr_seq[wr]"));
/*=== macro svt_xvm_create_on defined in /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_uvm_util.svip(1492) */ 

