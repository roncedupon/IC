`uvm_info("body", {`SVT_AXI_PRINT_PREFIX1(wr_seq[wr].wr_xact_req[0]), "Waiting for Write transaction to end"}, UVM_HIGH)
/*=== macro svt_xvm_debug defined in /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_uvm_util.svip(884) */ 

