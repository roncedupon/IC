begin 
        `svt_xvm_create_on(wr_xact_req[0], p_sequencer.master_sequencer[mstr]) 
        wr_xact_req[0].priority_start(this, -1); 
        if (!wr_xact_req[0].get_do_not_randomize() && !wr_xact_req[0].randomize() with {            addr                    >= lo_addr;            addr                    <= hi_addr-(burst_length*(1<<burst_size));            xact_type               == _write_xact_type[mstr];            coherent_xact_type      == svt_axi_transaction::WRITENOSNOOP;            atomic_type             == svt_axi_transaction::NORMAL;            burst_type              inside {svt_axi_transaction::INCR,svt_axi_transaction::WRAP};            foreach(wr_xact_req[0].wstrb[index])              wstrb[index] == '1;          } ) 
