    if(!((`SVT_NOCOPY|`SVT_NOCOMPARE|`SVT_DEEP)&UVM_NORECORD)) begin 
      int sz__ = region_ranges.size(); 
      string s; 
      if(sz__ == 0 ) begin 
        __m_uvm_status_container.recorder.record_field_int("region_ranges.size", 0, 32, UVM_DEC); 
      end 
      if(sz__ < 10) begin 
        foreach(region_ranges[i]) begin 
           $swrite(s,"region_ranges[%0d]", i); 
           __m_uvm_status_container.recorder.record_object(s, region_ranges[i]); 
        end 
      end 
      else begin 
        for(int i=0; i<5; ++i) begin 
