begin 
     if (uvm_report_enabled(UVM_HIGH,UVM_INFO,"body")) 
       uvm_report_info ("body", {`SVT_AXI_PRINT_PREFIX1(wr_seq[wr].wr_xact_req[0]), "Waiting for Write transaction to end"}, UVM_HIGH, `uvm_file, `uvm_line, "", 1); 
   end
/*=== macro uvm_info defined in /mnt/disk_0/IC/uvm-1.2/src/macros/uvm_message_defines.svh(116) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_ordering_sequence_collection.svp(2094), macro SVT_AXI_PRINT_PREFIX1(xact=wr_seq[wr].wr_xact_req[0]) */
$sformatf("{OBJECT_NUM('d%0d) PORT_ID('d%0d) PORT_NAME(%0s) TYPE(%0s) COHERENT_XACT_TYPE(%0s) ID('h%0x) SECURE('d%0d) ADDR('h%0x) CACHE_TYPE('d%0d) %0s%0s%0s} ",
          ((wr_seq[wr].wr_xact_req[0] != null)?wr_seq[wr].wr_xact_req[0].object_id:-1),
