     uvm_callback_iter#(uvm_phase,uvm_phase_cb) iter = new(this); 
     uvm_phase_cb cb = iter.first(); 
     while(cb != null) begin 
       `uvm_cb_trace_noobj(cb,$sformatf("Executing callback method 'phase_state_change(this, state_chg)' for callback %s (uvm_phase_cb) from %s (uvm_phase)",cb.get_name(), this.get_full_name())) 
       cb.phase_state_change(this, state_chg); 
       cb = iter.next(); 
     end 
   end
