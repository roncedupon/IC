                                     int what__, 
                                     string str__); 
   begin 
     svt_configuration local_data__;  
     typedef svt_configuration ___local_type____; 
     string string_aa_key;  
     uvm_object __current_scopes[$]; 
     if(what__ inside {UVM_SETINT,UVM_SETSTR,UVM_SETOBJ}) begin 
