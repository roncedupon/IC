/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_burst_sequence_collection.svp(2502), macro svt_xvm_do_on_with(SEQ_OR_ITEM=exclusive_normal_seq, SEQR=p_sequencer.master_sequencer[mstr], CONSTRAINTS={          slv_num == supporting_slaves[slv];        }) */
`svt_xvm_do_on_pri_with(exclusive_normal_seq, p_sequencer.master_sequencer[mstr], -1, {          slv_num == supporting_slaves[slv];        })
/*=== macro svt_xvm_do_on_with defined in /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_uvm_util.svip(1504) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_burst_sequence_collection.svp(2502), macro svt_xvm_do_on_pri_with(SEQ_OR_ITEM=exclusive_normal_seq, SEQR=p_sequencer.master_sequencer[mstr], PRIORITY=-1, CONSTRAINTS={          slv_num == supporting_slaves[slv];        }) */
begin 
        `svt_xvm_create_on(exclusive_normal_seq, p_sequencer.master_sequencer[mstr]) 
        exclusive_normal_seq.priority_start(this, -1); 
        if (!exclusive_normal_seq.get_do_not_randomize() && !exclusive_normal_seq.randomize() with {          slv_num == supporting_slaves[slv];        } ) 
          `svt_xvm_warning("RNDFLD", "Randomization failed in uvm_do_with action") 
        exclusive_normal_seq.priority_finish(this, -1); 
      end
/*=== macro svt_xvm_do_on_pri_with defined in /mnt/disk_0/softwares/vips/designware/vip/svt/common/R-2020.12/sverilog/src/vcs/svt_uvm_util.svip(1512) */ 

