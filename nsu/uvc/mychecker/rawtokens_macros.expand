    ( 
      (wr_seq[mstr_l].wr_xact_req[wr_l].port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) || 
      (wr_seq[mstr_l].wr_xact_req[wr_l].port_cfg.axi_interface_type == svt_axi_port_configuration::ACE_LITE) 
    ) && 
    (wr_seq[mstr_l].wr_xact_req[wr_l].is_coherent_xact_dropped == 1) 
  ) || 
  ( 
    (wr_seq[mstr_l].wr_xact_req[wr_l].port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) && 
    ( 
      (wr_seq[mstr_l].wr_xact_req[wr_l].ack_status == svt_axi_transaction::ACCEPT) || 
      (wr_seq[mstr_l].wr_xact_req[wr_l].ack_status == svt_axi_transaction::ABORTED) 
    ) 
  ) || 
  ( 
    (wr_seq[mstr_l].wr_xact_req[wr_l].port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_WRITE(wr_seq[mstr_l].wr_xact_req[wr_l])) && 
    ( 
      ( 
        (wr_seq[mstr_l].wr_xact_req[wr_l].write_resp_status == svt_axi_transaction::ACCEPT) || 
        (wr_seq[mstr_l].wr_xact_req[wr_l].write_resp_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) || 
  ( 
    (wr_seq[mstr_l].wr_xact_req[wr_l].port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_READ(wr_seq[mstr_l].wr_xact_req[wr_l])) &&  
    ( 
      ( 
        (wr_seq[mstr_l].wr_xact_req[wr_l].data_status == svt_axi_transaction::ACCEPT) || 
        (wr_seq[mstr_l].wr_xact_req[wr_l].data_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) 
)
