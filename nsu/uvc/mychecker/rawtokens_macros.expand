    ( 
      (wr_seq[mstr_l].wr_xact_req[wr_l].ack_status == svt_axi_transaction::ACCEPT) || 
      (wr_seq[mstr_l].wr_xact_req[wr_l].ack_status == svt_axi_transaction::ABORTED) 
