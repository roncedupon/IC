       ignore_bins ignore_exclusive = {`SVT_AXI_LOCK_WIDTH'd`SVT_AXI_TRANSACTION_EXCLUSIVE} 
                             iff(cfg.exclusive_access_enable == 0); 
       ignore_bins resvd = {`SVT_AXI_LOCK_WIDTH'd3}; 
