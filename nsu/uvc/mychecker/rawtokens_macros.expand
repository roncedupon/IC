begin 
        `svt_xvm_create_on(wr_xact, p_sequencer.master_sequencer[mstr]) 
        wr_xact.priority_start(this, -1); 
        if (!wr_xact.get_do_not_randomize() && !wr_xact.randomize() with {            addr                >=  lo_addr;            addr                <=  hi_addr-(burst_length*(1<<burst_size)) ;            xact_type           == _write_xact_type[mstr];            atomic_type         == svt_axi_transaction::NORMAL;            coherent_xact_type  == svt_axi_transaction::WRITENOSNOOP;            burst_type          inside {svt_axi_transaction::INCR,svt_axi_transaction::WRAP};            cache_type[0]       == 1'b1;          } ) 
          `svt_xvm_warning("RNDFLD", "Randomization failed in uvm_do_with action") 
        wr_xact.priority_finish(this, -1); 
      end
