( 
  ( 
    ( 
      (read_xact_queue[i].port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) || 
      (read_xact_queue[i].port_cfg.axi_interface_type == svt_axi_port_configuration::ACE_LITE) 
    ) && 
    (read_xact_queue[i].is_coherent_xact_dropped == 1) 
  ) || 
  ( 
    (read_xact_queue[i].port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) && 
    ( 
      (read_xact_queue[i].ack_status == svt_axi_transaction::ACCEPT) || 
      (read_xact_queue[i].ack_status == svt_axi_transaction::ABORTED) 
    ) 
  ) || 
  ( 
    (read_xact_queue[i].port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_WRITE(read_xact_queue[i])) && 
    ( 
      ( 
        (read_xact_queue[i].write_resp_status == svt_axi_transaction::ACCEPT) || 
        (read_xact_queue[i].write_resp_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) || 
  ( 
    (read_xact_queue[i].port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_READ(read_xact_queue[i])) &&  
    ( 
      ( 
        (read_xact_queue[i].data_status == svt_axi_transaction::ACCEPT) || 
        (read_xact_queue[i].data_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) 
)
