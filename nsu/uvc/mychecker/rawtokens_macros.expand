begin 
        `svt_xvm_create_on(xact, p_sequencer.master_sequencer[mstr]) 
        xact.priority_start(this, -1); 
        if (!xact.get_do_not_randomize() && !xact.randomize() with {            addr                >=  lo_addr;            addr                <=  hi_addr -(burst_length*(1<<burst_size));            xact_type           == _write_xact_type[mstr];            coherent_xact_type  == svt_axi_transaction::WRITENOSNOOP;            atomic_type         == svt_axi_transaction::NORMAL;            burst_type          inside {svt_axi_transaction::INCR,svt_axi_transaction::WRAP};            cache_type[1:0]     == 2'b00;          } ) 
          `svt_xvm_warning("RNDFLD", "Randomization failed in uvm_do_with action") 
        xact.priority_finish(this, -1); 
      end
