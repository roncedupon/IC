`__FILE__
/*=== macro uvm_file defined in /mnt/disk_0/IC/uvm-1.2/src/macros/uvm_message_defines.svh(45) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_ordering_sequence_collection.svp(2736), macro uvm_line */
`__LINE__
/*=== macro uvm_line defined in /mnt/disk_0/IC/uvm-1.2/src/macros/uvm_message_defines.svh(51) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_ordering_sequence_collection.svp(2738), macro SVT_AXI_XACT_STATUS_ENDED(this_xact=wr_seq.wr_xact_req[wr]) */
( 
  ( 
    ( 
      (wr_seq.wr_xact_req[wr].port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) || 
      (wr_seq.wr_xact_req[wr].port_cfg.axi_interface_type == svt_axi_port_configuration::ACE_LITE) 
    ) && 
    (wr_seq.wr_xact_req[wr].is_coherent_xact_dropped == 1) 
  ) || 
  ( 
    (wr_seq.wr_xact_req[wr].port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) && 
    ( 
      (wr_seq.wr_xact_req[wr].ack_status == svt_axi_transaction::ACCEPT) || 
      (wr_seq.wr_xact_req[wr].ack_status == svt_axi_transaction::ABORTED) 
    ) 
  ) || 
  ( 
    (wr_seq.wr_xact_req[wr].port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_WRITE(wr_seq.wr_xact_req[wr])) && 
    ( 
      ( 
        (wr_seq.wr_xact_req[wr].write_resp_status == svt_axi_transaction::ACCEPT) || 
        (wr_seq.wr_xact_req[wr].write_resp_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) || 
  ( 
    (wr_seq.wr_xact_req[wr].port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_READ(wr_seq.wr_xact_req[wr])) &&  
    ( 
      ( 
        (wr_seq.wr_xact_req[wr].data_status == svt_axi_transaction::ACCEPT) || 
        (wr_seq.wr_xact_req[wr].data_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) 
)
/*=== macro SVT_AXI_XACT_STATUS_ENDED defined in /mnt/disk_0/softwares/vips/vip2020/include/sverilog/svt_axi_common_defines.svi(3436) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_system_env_svt/sverilog/src/vcs/svt_axi_3_4_interconnect_ts_ordering_sequence_collection.svp(2738), macro SVT_AXI_IS_TRANSMITTED_CHANNEL_WRITE(obj=wr_seq.wr_xact_req[wr]) */
((wr_seq.wr_xact_req[wr].xact_type == svt_axi_transaction::WRITE) || 
   ((wr_seq.wr_xact_req[wr].xact_type == svt_axi_transaction::COHERENT) && 
    ((wr_seq.wr_xact_req[wr].coherent_xact_type == svt_axi_transaction::WRITENOSNOOP) || 
     (wr_seq.wr_xact_req[wr].coherent_xact_type == svt_axi_transaction::WRITEUNIQUE) || 
`ifdef SVT_ACE5_ENABLE 
     (wr_seq.wr_xact_req[wr].coherent_xact_type == svt_axi_transaction::WRITEUNIQUEPTLSTASH) || 
     (wr_seq.wr_xact_req[wr].coherent_xact_type == svt_axi_transaction::WRITEUNIQUEFULLSTASH) || 
     (wr_seq.wr_xact_req[wr].coherent_xact_type == svt_axi_transaction::STASHONCESHARED) || 
     (wr_seq.wr_xact_req[wr].coherent_xact_type == svt_axi_transaction::STASHONCEUNIQUE) || 
     (wr_seq.wr_xact_req[wr].coherent_xact_type == svt_axi_transaction::STASHTRANSLATION) || 
`endif 
     (wr_seq.wr_xact_req[wr].coherent_xact_type == svt_axi_transaction::WRITELINEUNIQUE) || 
     (wr_seq.wr_xact_req[wr].coherent_xact_type == svt_axi_transaction::WRITECLEAN) || 
     (wr_seq.wr_xact_req[wr].coherent_xact_type == svt_axi_transaction::WRITEBACK) || 
     (wr_seq.wr_xact_req[wr].coherent_xact_type == svt_axi_transaction::WRITEEVICT) || 
     (wr_seq.wr_xact_req[wr].coherent_xact_type == svt_axi_transaction::EVICT) || 
     (wr_seq.wr_xact_req[wr].coherent_xact_type == svt_axi_transaction::WRITEBARRIER) 
    ) 
   ) 
  ) 
/*=== macro SVT_AXI_IS_TRANSMITTED_CHANNEL_WRITE defined in /mnt/disk_0/softwares/vips/vip2020/include/sverilog/svt_axi_common_defines.svi(3388) */ 

