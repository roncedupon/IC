begin 
        `svt_xvm_create_on(wr_seq_q[mstr], p_sequencer.master_sequencer[mstr]) 
        wr_seq_q[mstr].priority_start(this, -1); 
        if (!wr_seq_q[mstr].get_do_not_randomize() && !wr_seq_q[mstr].randomize() with {            slv_num             == slv;            num_of_wr_xact      == num_write_xacts;            address             == RANDOM_ADDR;            id                  == RANDOM;            interleave          == RANDOM_INTERLEAVE;          } ) 
          `svt_xvm_warning("RNDFLD", "Randomization failed in uvm_do_with action") 
        wr_seq_q[mstr].priority_finish(this, -1); 
      end
