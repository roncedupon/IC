/*=== /mnt/disk_0/IC/uvm-1.2/src/reg/uvm_reg_sequence.svh(59), macro m_uvm_object_create_func(T=uvm_reg_sequence #(BASE)) */
function uvm_object create (string name=""); 
     uvm_reg_sequence #(BASE) tmp; 
`ifdef UVM_OBJECT_DO_NOT_NEED_CONSTRUCTOR 
     tmp = new(); 
     if (name!="") 
       tmp.set_name(name); 
`else 
     if (name=="") tmp = new(); 
     else tmp = new(name); 
`endif 
     return tmp; 
   endfunction
