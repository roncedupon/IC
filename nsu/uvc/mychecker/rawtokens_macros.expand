    $fsdbDumpvars(1,$sformatf("%m"),"+all",fsdbfile_plus_filename); 
`else 
    $fsdbDumpvars(1,$sformatf("%m"),"+all",{"+fsdbfile+",`SVT_DEBUG_OPTS_FSDB_FILE_NAME}); 
`endif 
  end 
`endif
