     uvm_vreg_field tmp; 
`ifdef UVM_OBJECT_DO_NOT_NEED_CONSTRUCTOR 
     tmp = new(); 
     if (name!="") 
       tmp.set_name(name); 
`else 
     if (name=="") tmp = new(); 
     else tmp = new(name); 
`endif 
     return tmp; 
   endfunction
