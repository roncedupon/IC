          ((wr_seq_q[m].wr_xact_req[wr_l] != null)?(wr_seq_q[m].wr_xact_req[wr_l].atomic_type==svt_axi_transaction::EXCLUSIVE)?"EXCL":"":""),
          ((wr_seq_q[m].wr_xact_req[wr_l] != null)?((wr_seq_q[m].wr_xact_req[wr_l].get_begin_time()==-1)?"":($sformatf(" START_TIME(%0t)",wr_seq_q[m].wr_xact_req[wr_l].get_begin_realtime()))):""),
          ((wr_seq_q[m].wr_xact_req[wr_l] != null)?((wr_seq_q[m].wr_xact_req[wr_l].get_end_time()==-1)?"":($sformatf(" END_TIME(%0t)",wr_seq_q[m].wr_xact_req[wr_l].get_end_realtime()))):""))
