begin 
        `svt_xvm_create_on(dvm_complete_seq, m_sequencer) 
        dvm_complete_seq.priority_start(this, -1); 
        if (!dvm_complete_seq.get_do_not_randomize() && !dvm_complete_seq.randomize() with {seq_xact_type==svt_axi_transaction::DVMCOMPLETE;                          dvm_message_type == 3'b000;} ) 
