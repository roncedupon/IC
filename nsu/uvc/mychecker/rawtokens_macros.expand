do begin 
    int curr, max__; 
    uvm_printer p__; 
    max__=0; curr=0; 
    if(__m_uvm_status_container.printer!=null) p__ = __m_uvm_status_container.printer; 
    else p__ = uvm_default_printer; 
    
    foreach(system_domain_items[i]) max__ = i+1; 

    

    p__.m_scope.set_arg("system_domain_items");
    p__.print_array_header("system_domain_items", max__, "da(object)");
    if((p__.knobs.depth == -1) || (p__.knobs.depth+1 > p__.m_scope.depth())) 
    begin
      for(curr=0; curr<max__ && (p__.knobs.begin_elements == -1 || 
         p__.knobs.end_elements == -1 || curr<p__.knobs.begin_elements); ++curr) begin 
        if(((`SVT_NOCOPY|`SVT_NOCOMPARE|`SVT_DEEP)&UVM_REFERENCE) == 0) 
          p__.print_object(p__.index_string(curr), system_domain_items[curr], "[");
        else 
          p__.print_object_header(p__.index_string(curr), system_domain_items[curr], "[");
      end 
      if(curr<max__) begin
        curr = max__-p__.knobs.end_elements;
        if(curr<p__.knobs.begin_elements) curr = p__.knobs.begin_elements;
        else begin
          p__.print_array_range(p__.knobs.begin_elements, curr-1);
        end
        for(curr=curr; curr<max__; ++curr) begin
          if(((`SVT_NOCOPY|`SVT_NOCOMPARE|`SVT_DEEP)&UVM_REFERENCE) == 0) 
            p__.print_object(p__.index_string(curr), system_domain_items[curr], "[");
          else 
            p__.print_object_header(p__.index_string(curr), system_domain_items[curr], "[");
        end 
      end
    end 

    p__.print_array_footer(max__); 
    
  end while(0);
