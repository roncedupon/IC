/*=== macro uvm_line defined in /mnt/disk_0/IC/uvm-1.2/src/macros/uvm_message_defines.svh(51) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_master_agent_svt/sverilog/src/vcs/svt_axi_master_sequence_collection.svp(4336), macro SVT_AXI_XACT_STATUS_ENDED(this_xact=req) */
( 
  ( 
    ( 
      (req.port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) || 
      (req.port_cfg.axi_interface_type == svt_axi_port_configuration::ACE_LITE) 
    ) && 
    (req.is_coherent_xact_dropped == 1) 
  ) || 
  ( 
    (req.port_cfg.axi_interface_type == svt_axi_port_configuration::AXI_ACE) && 
    ( 
      (req.ack_status == svt_axi_transaction::ACCEPT) || 
      (req.ack_status == svt_axi_transaction::ABORTED) 
    ) 
  ) || 
  ( 
    (req.port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_WRITE(req)) && 
    ( 
      ( 
        (req.write_resp_status == svt_axi_transaction::ACCEPT) || 
        (req.write_resp_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) || 
  ( 
    (req.port_cfg.axi_interface_type != svt_axi_port_configuration::AXI_ACE) && 
    (`SVT_AXI_IS_TRANSMITTED_CHANNEL_READ(req)) &&  
    ( 
      ( 
        (req.data_status == svt_axi_transaction::ACCEPT) || 
        (req.data_status == svt_axi_transaction::ABORTED) 
      ) 
    ) 
  ) 
)
/*=== macro SVT_AXI_XACT_STATUS_ENDED defined in /mnt/disk_0/softwares/vips/vip2020/include/sverilog/svt_axi_common_defines.svi(3436) */ 

/*=== /mnt/disk_0/softwares/vips/designware/vip/svt/amba_svt/R-2020.12/axi_master_agent_svt/sverilog/src/vcs/svt_axi_master_sequence_collection.svp(4336), macro SVT_AXI_IS_TRANSMITTED_CHANNEL_WRITE(obj=req) */
((req.xact_type == svt_axi_transaction::WRITE) || 
   ((req.xact_type == svt_axi_transaction::COHERENT) && 
    ((req.coherent_xact_type == svt_axi_transaction::WRITENOSNOOP) || 
     (req.coherent_xact_type == svt_axi_transaction::WRITEUNIQUE) || 
`ifdef SVT_ACE5_ENABLE 
     (req.coherent_xact_type == svt_axi_transaction::WRITEUNIQUEPTLSTASH) || 
     (req.coherent_xact_type == svt_axi_transaction::WRITEUNIQUEFULLSTASH) || 
     (req.coherent_xact_type == svt_axi_transaction::STASHONCESHARED) || 
     (req.coherent_xact_type == svt_axi_transaction::STASHONCEUNIQUE) || 
     (req.coherent_xact_type == svt_axi_transaction::STASHTRANSLATION) || 
`endif 
