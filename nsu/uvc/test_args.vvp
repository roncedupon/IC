    %pushi/vec4 0, 0, 32; draw_string_vec4
    %concat/vec4; draw_string_vec4
    %pushi/vec4 6579558, 0, 32; draw_string_vec4
    %concat/vec4; draw_string_vec4
    %pushi/vec4 1635085428, 0, 32; draw_string_vec4
    %concat/vec4; draw_string_vec4
    %store/vec4 v0x55a324fc1280_0, 0, 256;
T_0.1 ;
    %vpi_func 2 17 "$value$plusargs" 32, "num=%d", v0x55a324fc0940_0 {0 0 0};
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_0.2, 4;
    %vpi_call 2 18 "$display", "First call: num= {%0d}......", v0x55a324fc0940_0 {0 0 0};
    %jmp T_0.3;
T_0.2 ;
    %pushi/vec4 100, 0, 32;
    %store/vec4 v0x55a324fc0940_0, 0, 32;
T_0.3 ;
    %vpi_call 2 22 "$display", "First call: %s---%0d", v0x55a324fc1280_0, v0x55a324fc0940_0 {0 0 0};
    %vpi_call 2 25 "$display", "\012Second call (simulating derived class):" {0 0 0};
    %vpi_func 2 26 "$value$plusargs" 32, "TESTNAME=%s", v0x55a324fc1280_0 {0 0 0};
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_0.4, 4;
    %vpi_call 2 27 "$display", "Second call: Running test {%0s}......", v0x55a324fc1280_0 {0 0 0};
    %jmp T_0.5;
T_0.4 ;
    %pushi/vec4 0, 0, 32; draw_string_vec4
    %pushi/vec4 0, 0, 32; draw_string_vec4
    %concat/vec4; draw_string_vec4
    %pushi/vec4 0, 0, 32; draw_string_vec4
    %concat/vec4; draw_string_vec4
    %pushi/vec4 0, 0, 32; draw_string_vec4
    %concat/vec4; draw_string_vec4
    %pushi/vec4 0, 0, 32; draw_string_vec4
    %concat/vec4; draw_string_vec4
    %pushi/vec4 0, 0, 32; draw_string_vec4
    %concat/vec4; draw_string_vec4
    %pushi/vec4 6579558, 0, 32; draw_string_vec4
    %concat/vec4; draw_string_vec4
    %pushi/vec4 1635085428, 0, 32; draw_string_vec4
    %concat/vec4; draw_string_vec4
    %store/vec4 v0x55a324fc1280_0, 0, 256;
T_0.5 ;
    %vpi_func 2 31 "$value$plusargs" 32, "num=%d", v0x55a324fc0940_0 {0 0 0};
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_0.6, 4;
