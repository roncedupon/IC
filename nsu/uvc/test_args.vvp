#! /usr/bin/vvp
:ivl_version "10.3 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "system";
:vpi_module "vhdl_sys";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x55a324fae100 .scope module, "test_args" "test_args" 2 4;
 .timescale -9 -12;
v0x55a324fc0940_0 .var "num", 31 0;
v0x55a324fc1280_0 .var "testname", 255 0;
    .scope S_0x55a324fae100;
T_0 ;
    %vpi_call 2 9 "$display", "=== Testing $value$plusargs ===" {0 0 0};
    %vpi_func 2 12 "$value$plusargs" 32, "TESTNAME=%s", v0x55a324fc1280_0 {0 0 0};
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_0.0, 4;
    %vpi_call 2 13 "$display", "First call: Running test {%0s}......", v0x55a324fc1280_0 {0 0 0};
    %jmp T_0.1;
T_0.0 ;
    %pushi/vec4 0, 0, 32; draw_string_vec4
