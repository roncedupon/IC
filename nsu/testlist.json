{
    "tests": [
        {
            "tc_list": "testlist/tc_basic_read",
            "pre_setup": "source /etc/profile",
            "extra_cmd": "-sim \"+UVM_VERBOSITY=UVM_NONE\"",
            "subcmd": [
                "-t basic_read_test",
                {
                    "cmd": "-t basic_read_test_with_extra",
                    "extra_cmd": "-sim \"+UVM_VERBOSITY=UVM_HIGH\""
                }
            ]
        },
        {
            "tc_list": "testlist/tc_basic_write",
            "pre_setup": "source /etc/profile",
            "subcmd": ["-t basic_write_test"]
        },
        {
            "tc_list": "testlist/tc_burst_transfer",
            "subcmd": ["-t burst_transfer_test"]
        },
        {
            "tc_list": "testlist/tc_error_handling",
            "subcmd":[
                "-t axi_pass_test"
            ],
            "pre_setup": "cd /path/to/error_test && source env.csh && export DEBUG=1"
        }
    ]
}
