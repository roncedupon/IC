# contains valuable trade secrets and proprietary information of 
# Artisan Components, Inc., and is protected by law.  It may not be
# copied or distributed in any form or medium, disclosed to third
# parties, reverse engineered or used in any manner not provided for
# in said License Agreement except with the prior written
# authorization from Artisan Components, Inc.
#
# Artisan Components, Inc.; San Jose, CA; 95110; USA 408-453-1000
#
# generic java wrapper for the generator.  Use jre 1.1 or later
#
# Used korn shell as whence is builtin whereas csh/sh does not have
# which builtin.  Faster this way.
#
# $Revision: 1.33.2.1 $

PKG_NAME="gui"

# remove any /./ since dirname gets confused
PRG=`whence $0 | sed 's|/\./|/|g'` 
PRG_HOME=`dirname $PRG`
BASE_DIR=`dirname $PRG_HOME`

UNAME_MACHINE=`(/usr/bin/uname -m) 2>/dev/null` || UNAME_MACHINE=unknown
UNAME_SYSTEM=`(/usr/bin/uname -s) 2>/dev/null` || UNAME_SYSTEM=unknown
UNAME_RELEASE=`(/usr/bin/uname -r) 2>/dev/null` || UNAME_RELEASE=unknown
UNAME_VERSION=`(/usr/bin/uname -v) 2>/dev/null` || UNAME_VERSION=unknown

DEBUG=${DEBUG_JAVA_DIR:-none}
if [[ $DEBUG != "none" ]]; then
   CLASSPATH=$DEBUG/$PKG_NAME/$PKG_NAME.zip
else
   CLASSPATH=$BASE_DIR/lib/$PKG_NAME.zip
fi

case "${UNAME_MACHINE}:${UNAME_SYSTEM}:${UNAME_RELEASE}:${UNAME_VERSION}" in
    sun4*:SunOS:5.*:*)
        JRE_HOME=$BASE_DIR/lib/sparc/jre
        JRE=$JRE_HOME/bin/jre
	JRE_TILING=$JRE_HOME/bin/jre_tiling
	;;
#    *:HP-UX:*:*)
#        JRE_HOME=$BASE_DIR/lib/hppa2.0/jre
#        JRE=$JRE_HOME/bin/jre
#	JRE_TILING=$JRE_HOME/bin/jre_tiling
#	;;
    *)
        echo "This program is not supported on this machine:"
	/usr/bin/uname -a
        exit 1
	;;
esac

CLASSPATH=$CLASSPATH:$BASE_DIR/lib/swingall.jar:$JRE_HOME/lib/rt.jar:$JRE_HOME/lib/i18n.jar:$JRE_HOME/lib/classes.zip

export CLASSPATH

JAVA_HOME=
export JAVA_HOME

LANG=C
LC_ALL=C
export LANG
export LC_ALL

LD_LIBRARY_PATH=
export LD_LIBRARY_PATH

exec $JRE -nojit -noclassgc -Dbasedir=$BASE_DIR Main "$@"

